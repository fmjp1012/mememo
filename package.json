{
  "name": "mememo-learning-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:pipeline": "vite --config apps/pipeline-compare/vite.config.js --host 127.0.0.1 --port 5176",
    "dev:compare": "npm run dev:pipeline",
    "build:pipeline": "vite build --config apps/pipeline-compare/vite.config.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:prod": "E2E_BASE_URL=https://mememo-study.com playwright test",
    "dev:worker": "npm run build && wrangler dev",
    "deploy:cloudflare": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "@vitejs/plugin-react": "^5.0.0",
    "katex": "^0.17.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "wrangler": "^4.127.1"
  }
}
