VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Supabase Auth setup:
# - Enable Email/Password, Google, and Apple providers as needed.
# - Add the production origin and local dev origin to Auth > URL Configuration.
# - Run supabase/schema.sql so signed-in users can sync their own learning state.

# Cloudflare Worker secrets (set with `wrangler secret put`, never commit values)
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-public-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# ADMIN_EMAILS=verified-admin@example.com,second-admin@example.com
# ADMIN_USER_IDS=optional-supabase-user-id
# FULL_ACCESS_EMAILS=verified-operator@example.com
# FULL_ACCESS_USER_IDS=optional-supabase-user-id
# STRIPE_SECRET_KEY=sk_live_or_test
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_MONTHLY_PRICE_ID=price_...
# STRIPE_YEARLY_PRICE_ID=price_...
# COOKIE_SIGNING_SECRET=at-least-32-random-bytes

# Local admin UI preview only (never use as a production authorization mechanism)
# VITE_MEMEMO_DEV_ADMIN=1
